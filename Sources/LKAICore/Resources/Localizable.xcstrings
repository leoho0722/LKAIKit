{
  "sourceLanguage" : "en",
  "strings" : {
    "error.lkai.cancelled" : {
      "comment" : "請求在完成前被取消時顯示",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The request was cancelled."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請求已取消。"
          }
        }
      }
    },
    "error.lkai.invalidAPIKey" : {
      "comment" : "供應商拒絕這把 API 金鑰、認為它無效或已失效時顯示",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The API key is invalid."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API 金鑰無效。"
          }
        }
      }
    },
    "error.lkai.invalidRequest" : {
      "comment" : "供應商認為請求內容有問題、無法處理時顯示；不含供應商給的技術訊息",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The request couldn't be processed."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法處理這個請求。"
          }
        }
      }
    },
    "error.lkai.invalidResponse" : {
      "comment" : "供應商回傳的內容不符預期、無法解讀時顯示",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The service returned an unexpected response."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服務回傳了無法辨識的回應。"
          }
        }
      }
    },
    "error.lkai.permissionDenied" : {
      "comment" : "API 金鑰有效，但沒有權限使用這項服務時顯示",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You don't have permission to use this service."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有使用這項服務的權限。"
          }
        }
      }
    },
    "error.lkai.quotaExceeded" : {
      "comment" : "帳號的用量上限或餘額已用完時顯示",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The usage limit has been reached."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已達到用量上限。"
          }
        }
      }
    },
    "error.lkai.rateLimited" : {
      "comment" : "短時間內送出太多請求、被供應商限流時顯示",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too many requests. Please try again later."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請求過於頻繁，請稍後再試。"
          }
        }
      }
    },
    "error.lkai.refused" : {
      "comment" : "AI 拒絕回應這個請求時顯示；不含拒答的原因",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The AI declined to respond to this request."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 拒絕回應這個請求。"
          }
        }
      }
    },
    "error.lkai.serviceUnavailable" : {
      "comment" : "供應商的服務過載或維護中、暫時無法使用時顯示",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The service is temporarily unavailable. Please try again later."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服務暫時無法使用，請稍後再試。"
          }
        }
      }
    },
    "error.lkai.transport" : {
      "comment" : "沒有網路或連線中斷、連不上供應商時顯示；不含系統回報的錯誤文字",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't connect to the service. Check your network connection."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法連線到服務，請檢查網路連線。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
