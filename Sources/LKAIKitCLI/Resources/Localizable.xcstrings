{
  "sourceLanguage" : "en",
  "strings" : {
    "cli.help.abstract" : {
      "comment" : "lkai 說明畫面最上方的簡介",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send a prompt to an AI service and print the answer, for CI/CD workflows."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將提示詞送給 AI 服務並印出回答，適合用在 CI/CD 流程。"
          }
        }
      }
    },
    "cli.help.apiKey" : {
      "comment" : "--apiKey 選項的說明；必須寫明沒給時讀環境變數，以及在 CI 中優先使用環境變數的理由",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The API key. If not given, the environment variable of the selected provider is used. In CI, prefer the environment variable: command-line arguments stay in the shell history and the process list."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API 金鑰。沒有給時，讀取所選供應商的環境變數。在 CI 中請優先使用環境變數，因為命令列引數會留在 shell 的歷史紀錄與程序清單中。"
          }
        }
      }
    },
    "cli.help.discussion" : {
      "comment" : "lkai 說明畫面的補充說明，含環境變數與四個退出碼；%@ 代入各供應商讀取金鑰的環境變數名稱，以逗號分隔",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends the prompt to an AI service as one request and prints the answer to standard output. Errors and warnings go to standard error.\n\nWithout --apiKey, the API key is read from the environment variable of the selected provider, one of: %@\n\nExit codes:\n0: The answer is complete.\n1: The AI service returned an error, the request timed out, or the stream stopped before it finished.\n2: The answer did not finish normally, for example because it reached --max-output-tokens. The answer is still printed.\n64: The input is invalid."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將提示詞作為一次請求送給 AI 服務，回答印到標準輸出，錯誤與警告印到標準錯誤。\n\n沒有給 --apiKey 時，從所選供應商的環境變數讀取 API 金鑰，可用的環境變數：%@\n\n退出碼：\n0：回答完整。\n1：AI 服務回報錯誤、連線逾時，或串流在結束前停止。\n2：回答沒有正常完成，例如達到 --max-output-tokens；回答仍會印出。\n64：輸入有誤。"
          }
        }
      }
    },
    "cli.help.maxOutputTokens" : {
      "comment" : "--max-output-tokens 選項的說明；預設值由解析器自動附上，這裡不重複",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The maximum number of tokens in the answer. Models that think before answering count their thinking tokens too."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答最多可使用的 token 數。會先思考的模型，思考用的 token 也會計入。"
          }
        }
      }
    },
    "cli.help.model" : {
      "comment" : "--model 選項的說明",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The name of the model to use, passed to the service as given. Required to send a prompt."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要使用的模型名稱，原樣交給 AI 服務。送出提示詞時必填。"
          }
        }
      }
    },
    "cli.help.outputLanguage" : {
      "comment" : "--output-language 選項的說明；必須寫明只影響 lkai 自己的訊息，不影響 AI 回答的語言",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The language of lkai's own messages: help text, input errors and warnings. Text generated by the argument parser stays in English. The language of the AI's answer is not affected."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "lkai 自己的訊息使用的語言，包含說明、輸入錯誤與警告；引數解析器產生的文字固定為英文。不影響 AI 回答的語言。"
          }
        }
      }
    },
    "cli.help.prompt" : {
      "comment" : "--prompt 選項的說明；必須寫明以 - 開頭的內容要改用 --prompt=<text> 或 --prompt-file",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The prompt text. Use either --prompt or --prompt-file. If the text starts with -, write --prompt=<text> or use --prompt-file instead."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示詞的文字，與 --prompt-file 擇一使用。內容以 - 開頭時，請改寫成 --prompt=<text>，或改用 --prompt-file。"
          }
        }
      }
    },
    "cli.help.promptFile" : {
      "comment" : "--prompt-file 選項的說明",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The path of a .txt or .md file that holds the prompt, read as UTF-8. Use either --prompt or --prompt-file."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存放提示詞的 .txt 或 .md 檔案路徑，以 UTF-8 讀取，與 --prompt 擇一使用。"
          }
        }
      }
    },
    "cli.help.provider" : {
      "comment" : "--provider 選項的說明",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The AI service to use. Required to send a prompt."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要使用的 AI 服務。送出提示詞時必填。"
          }
        }
      }
    },
    "cli.help.stream" : {
      "comment" : "--stream 選項的說明",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Print the answer as it arrives instead of after it is complete. If the call fails, part of the answer may already be printed."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "邊收邊印出回答，不等回答完成。呼叫失敗時，可能已經印出部分回答。"
          }
        }
      }
    },
    "cli.help.timeout" : {
      "comment" : "--timeout 選項的說明；必須寫明是多久沒有收到任何資料就放棄，不是整個請求的總時間",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How many seconds to wait without receiving any data from the AI service before giving up. The timer restarts each time data arrives."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多久沒有收到 AI 服務的任何資料就放棄，單位為秒。每收到資料就重新計時。"
          }
        }
      }
    },
    "cli.help.version" : {
      "comment" : "-v、--version 選項的說明",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show the version number and exit."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示版本號碼並結束。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
