{
  "sourceLanguage" : "en",
  "strings" : {
    "cli.help.abstract" : {
      "comment" : "lkai 說明畫面最上方的簡介",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send a prompt to an AI service and print the answer, for CI/CD workflows."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將提示詞送給 AI 服務並印出回答，適合用在 CI/CD 流程。"
          }
        }
      }
    },
    "cli.help.apiKey" : {
      "comment" : "--apiKey 選項的說明；必須寫明沒給時讀環境變數，以及在 CI 中優先使用環境變數的理由",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The API key. If not given, the environment variable of the selected provider is used. In CI, prefer the environment variable: command-line arguments stay in the shell history and the process list."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API 金鑰。沒有給時，讀取所選供應商的環境變數。在 CI 中請優先使用環境變數，因為命令列引數會留在 shell 的歷史紀錄與程序清單中。"
          }
        }
      }
    },
    "cli.help.discussion" : {
      "comment" : "lkai 說明畫面的補充說明，含環境變數與四個退出碼；%@ 代入各供應商讀取金鑰的環境變數名稱，以逗號分隔",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends the prompt to an AI service as one request and prints the answer to standard output. Errors and warnings go to standard error.\n\nWithout --apiKey, the API key is read from the environment variable of the selected provider, one of: %@\n\nExit codes:\n0: The answer is complete.\n1: The chat did not succeed: the AI service returned an error, the network failed or timed out, the stream stopped before it finished, or the answer could not be written to standard output.\n2: The answer did not finish normally, for example because it reached --max-output-tokens. The answer is still printed.\n64: The input is invalid."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將提示詞作為一次請求送給 AI 服務，回答印到標準輸出，錯誤與警告印到標準錯誤。\n\n沒有給 --apiKey 時，從所選供應商的環境變數讀取 API 金鑰，可用的環境變數：%@\n\n退出碼：\n0：回答完整。\n1：對話沒有成功：AI 服務回報錯誤、網路失敗或逾時、串流在結束前停止，或回答無法寫到標準輸出。\n2：回答沒有正常完成，例如達到 --max-output-tokens；回答仍會印出。\n64：輸入有誤。"
          }
        }
      }
    },
    "cli.help.maxOutputTokens" : {
      "comment" : "--max-output-tokens 選項的說明；預設值由解析器自動附上，這裡不重複",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The maximum number of tokens in the answer. Models that think before answering count their thinking tokens too."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答最多可使用的 token 數。會先思考的模型，思考用的 token 也會計入。"
          }
        }
      }
    },
    "cli.help.model" : {
      "comment" : "--model 選項的說明",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The name of the model to use, passed to the service as given. Required to send a prompt."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要使用的模型名稱，原樣交給 AI 服務。送出提示詞時必填。"
          }
        }
      }
    },
    "cli.help.outputLanguage" : {
      "comment" : "--output-language 選項的說明；必須寫明只影響 lkai 自己的訊息，不影響 AI 回答的語言",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The language of lkai's own messages: help text, input errors and warnings. Text generated by the argument parser stays in English. The language of the AI's answer is not affected."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "lkai 自己的訊息使用的語言，包含說明、輸入錯誤與警告；引數解析器產生的文字固定為英文。不影響 AI 回答的語言。"
          }
        }
      }
    },
    "cli.help.prompt" : {
      "comment" : "--prompt 選項的說明；必須寫明以 - 開頭的內容要改用 --prompt=<text> 或 --prompt-file",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The prompt text. Use either --prompt or --prompt-file. If the text starts with -, write --prompt=<text> or use --prompt-file instead."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示詞的文字，與 --prompt-file 擇一使用。內容以 - 開頭時，請改寫成 --prompt=<text>，或改用 --prompt-file。"
          }
        }
      }
    },
    "cli.help.promptFile" : {
      "comment" : "--prompt-file 選項的說明",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The path of a .txt or .md file that holds the prompt, read as UTF-8. Use either --prompt or --prompt-file."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存放提示詞的 .txt 或 .md 檔案路徑，以 UTF-8 讀取，與 --prompt 擇一使用。"
          }
        }
      }
    },
    "cli.help.provider" : {
      "comment" : "--provider 選項的說明",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The AI service to use. Required to send a prompt."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要使用的 AI 服務。送出提示詞時必填。"
          }
        }
      }
    },
    "cli.help.stream" : {
      "comment" : "--stream 選項的說明",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Print the answer as it arrives instead of after it is complete. If the call fails, part of the answer may already be printed."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "邊收邊印出回答，不等回答完成。呼叫失敗時，可能已經印出部分回答。"
          }
        }
      }
    },
    "cli.help.timeout" : {
      "comment" : "--timeout 選項的說明；必須寫明是多久沒有收到任何資料就放棄，不是整個請求的總時間",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How many seconds to wait without receiving any data from the AI service before giving up. The timer restarts each time data arrives."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多久沒有收到 AI 服務的任何資料就放棄，單位為秒。每收到資料就重新計時。"
          }
        }
      }
    },
    "cli.help.version" : {
      "comment" : "-v、--version 選項的說明",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show the version number and exit."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示版本號碼並結束。"
          }
        }
      }
    },
    "error.cli.answerWriteFailed" : {
      "comment" : "回答無法寫到標準輸出時，顯示在 Error: 之後；不帶參數，不含環境變數名稱",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't write the answer to standard output."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法將回答寫到標準輸出。"
          }
        }
      }
    },
    "error.cli.blankPrompt" : {
      "comment" : "--prompt 的內容是空字串或只有空白時顯示；訊息要含 --prompt",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The --prompt text is empty or contains only whitespace."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--prompt 的內容是空的，或只有空白。"
          }
        }
      }
    },
    "error.cli.blankPromptFile" : {
      "comment" : "提示詞檔案的內容是空的或只有空白時顯示；%@ 代入檔案路徑，訊息要含路徑",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The prompt file is empty or contains only whitespace: %@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示詞檔案是空的，或只有空白：%@"
          }
        }
      }
    },
    "error.cli.conflictingPrompts" : {
      "comment" : "--prompt 與 --prompt-file 同時給了時顯示；訊息要含 --prompt-file",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use either --prompt or --prompt-file, not both."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--prompt 與 --prompt-file 只能擇一使用，不能同時給。"
          }
        }
      }
    },
    "error.cli.invalidMaxOutputTokens" : {
      "comment" : "--max-output-tokens 小於 1 時顯示；訊息要含 --max-output-tokens",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--max-output-tokens must be at least 1."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--max-output-tokens 必須至少為 1。"
          }
        }
      }
    },
    "error.cli.invalidTimeout" : {
      "comment" : "--timeout 小於 1 時顯示；訊息要含 --timeout",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--timeout must be at least 1 second."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--timeout 必須至少為 1 秒。"
          }
        }
      }
    },
    "error.cli.missingAPIKey" : {
      "comment" : "沒有給 --apiKey，所選供應商的環境變數也沒有值時顯示；%@ 代入環境變數名稱，訊息要含 --apiKey",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No API key is available. Pass --apiKey, or set the environment variable %@."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有可用的 API 金鑰。請以 --apiKey 傳入，或設定環境變數 %@。"
          }
        }
      }
    },
    "error.cli.missingModel" : {
      "comment" : "沒有給 --model，或給的是空字串時顯示；訊息要含 --model",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Specify the model to use with --model."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請以 --model 指定要使用的模型。"
          }
        }
      }
    },
    "error.cli.missingPrompt" : {
      "comment" : "--prompt 與 --prompt-file 都沒給時顯示；訊息要含 --prompt",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provide a prompt with --prompt or --prompt-file."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請以 --prompt 或 --prompt-file 提供提示詞。"
          }
        }
      }
    },
    "error.cli.missingProvider" : {
      "comment" : "沒有給 --provider 時顯示；訊息要含 --provider",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Specify the AI service to use with --provider."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請以 --provider 指定要使用的 AI 服務。"
          }
        }
      }
    },
    "error.cli.unreadablePromptFile" : {
      "comment" : "提示詞檔案找不到、是資料夾或不是 UTF-8 時顯示；%@ 代入檔案路徑，訊息要含路徑",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cannot read the file given to --prompt-file as UTF-8 text: %@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法以 UTF-8 讀取 --prompt-file 指定的檔案：%@"
          }
        }
      }
    },
    "error.cli.unsupportedPromptFile" : {
      "comment" : "提示詞檔案的副檔名不是 txt 或 md 時顯示；%@ 代入檔案路徑，訊息要含 --prompt-file",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--prompt-file accepts only .txt and .md files: %@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "--prompt-file 只接受 .txt 或 .md 檔案：%@"
          }
        }
      }
    },
    "warning.cli.contextWindowExceeded" : {
      "comment" : "提示詞加回答塞滿模型的 context window 而被截斷時，顯示在 Warning: 之後；英文訊息要含 context window",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The answer was cut off because the prompt and the answer filled the model's context window. Raising --max-output-tokens does not help; shorten the prompt or use a model with a larger context window."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答被截斷，因為提示詞加上回答已經塞滿模型的上下文視窗。調高 --max-output-tokens 沒有用，請縮短提示詞，或改用上下文視窗更大的模型。"
          }
        }
      }
    },
    "warning.cli.maxOutputTokens" : {
      "comment" : "回答達到輸出上限而被截斷時，顯示在 Warning: 之後；訊息要含 --max-output-tokens",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The answer was cut off because it reached the output limit. Raise --max-output-tokens to allow a longer answer."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答因為達到輸出上限而被截斷。請調高 --max-output-tokens，讓回答可以更長。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
